# SQLite DBs (registry + per-campaign stores are per-machine state).
*.db

# Retired beads/Dolt tracker (migrated to GitHub Issues 2026-07-28; the frozen
# from a retired tracker). Ignored so a stray run of an old
# clone cannot resurrect a competing tracker in git.
.beads/
.dolt/
.beads-credential-key

# Stray node_modules at repo root: vitest scaffolds one in CWD when
# run from the wrong directory. The real one lives in frontend/.
/node_modules/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# CK3 / Chronicler runtime artifacts (per-machine, never push)
debug.log
logs/
# Issue #24: data/ is entirely per-machine runtime state now. It used to
# carry a per-path ignore dance so data/archived/** could stay COMMITTED —
# git was the cross-machine transport for sealed-campaign snapshots, which
# only worked because the remote was private and single-user. A public
# origin breaks that in both directions (a user cannot push to it; the
# owner's pushes would publish personal campaign data), so snapshots live
# under the platform data dir and syncing them is the user's own choice of
# vehicle. See docs/archived-campaigns.md.
data/
campaigns/
biographies/
# but keep fixture biographies committed for prompt-iteration regression tests
!tests/fixtures/biographies/
# ...and the shippable prose template's biographies dir, which `chronicler
# init-prose` copies verbatim. Without this the bare `biographies/` rule above
# silently drops it from the tree: the template is then incomplete in every
# fresh clone (and in CI) while still passing locally off untracked leftovers.
!prose-template/biographies/
*.ck3
# Real-save fixtures are too large to commit (~25-200MB binary, ~150MB JSON
# after rakaly). The golden test (tests/integration/test_real_save_golden.py)
# discovers any *.ck3 dropped into tests/fixtures/saves/ at runtime — see
# tests/fixtures/saves/README.md.
tests/fixtures/saves/*.rakaly.json

# Local LLM / model caches
.ollama/
models/

# Lint tooling (binary, fetched per machine — see scripts/run_tiger.py)
ck3-tiger-*/

# Save-parsing tooling (binary, fetched per machine — see scripts/run_rakaly.py)
rakaly-*/

# IDE
.vscode/
.idea/

# OS junk
Thumbs.db
.DS_Store

# Secrets
.env
.env.*
!.env.example

# bv (beads viewer) local config and caches — sidecar of the retired bd tracker
.bv/
# Vite production build output (gets regenerated by `cd frontend && npm run build`)
src/chronicler/api/static/app/

# Scratch screenshots from design/UI iteration (legit assets live in reference/).
# /*.png stays for safety in case anything is dropped at the root again;
# design/scratch/ is the tidy home for ad-hoc UI mockup iteration output.
/*.png
design/scratch/

# Claude Code runtime
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Playwright MCP scratch
.playwright-mcp/

# Audit working state
.audit-*
